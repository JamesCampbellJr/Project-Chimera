#.env
# Ollama configuration
OLLAMA_HOST=http://localhost:11434

# -----------------------------------------------------------------------
# Solana Paper-Trading Bot
# -----------------------------------------------------------------------

# Solana RPC endpoint (default: public mainnet-beta, no key required)
# For higher rate limits use a private node or a provider like Helius / QuickNode:
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# How long (seconds) to wait for each RPC call before timing out
SOLANA_RPC_TIMEOUT=30

# Delay between RPC calls (seconds) to stay within free-tier rate limits
RPC_RATE_LIMIT_DELAY=0.5

# SQLite database path (relative to the Project Chimera directory)
TRADING_DB_PATH=trading/chimera_trading.db

# Virtual cash to start with (USD)
PAPER_TRADING_STARTING_BALANCE=10000.0

# Position sizing: each trade is this % of available cash, capped at max
PAPER_POSITION_SIZE_PCT=5.0
PAPER_MAX_POSITION_USD=500.0
PAPER_MIN_TRADE_USD=10.0

# Risk management
PAPER_TAKE_PROFIT_PCT=20.0   # close position at +20%
PAPER_STOP_LOSS_PCT=10.0     # close position at -10%

# Minimum pattern confidence score to act on (0.0–1.0)
MIN_SIGNAL_SCORE=0.60

# Target win-rate to declare the bot "profitable" (%)
TARGET_WIN_RATE_PCT=90.0

# Seconds between bot loop iterations
TRADING_LOOP_INTERVAL=300

# --- Risk Management ---
RISK_KELLY_SAFETY_MULTIPLIER=0.5   # half-Kelly for position sizing
RISK_TRAILING_STOP_PCT=8.0         # trail 8% from peak price
RISK_MAX_DRAWDOWN_PCT=20.0         # circuit breaker at 20% drawdown
RISK_MAX_CONSECUTIVE_LOSSES=5      # circuit breaker after 5 losses

# --- Sentiment Analysis ---
SENTIMENT_BEARISH_THRESHOLD=-0.3   # block if token sentiment < this
SENTIMENT_MARKET_FEAR_THRESHOLD=-0.5  # block all trading if market < this

# --- Manipulation Detection ---
MANIPULATION_BLOCK_SEVERITY=0.5    # block trading if severity >= this
WASH_TRADE_WINDOW_SECS=60          # wash trade detection window
PUMP_MIN_WALLETS=5                 # min wallets for pump detection
PUMP_WINDOW_SECS=180               # pump detection window
COORDINATED_MIN_COOCCURRENCES=3    # min co-trades for coordination flag

# --- Technical Indicators ---
RSI_OVERSOLD=30.0                  # RSI below = oversold (buy signal)
RSI_OVERBOUGHT=70.0                # RSI above = overbought (sell signal)
MOMENTUM_BUY_THRESHOLD=5.0         # % rate-of-change for buy
MOMENTUM_SELL_THRESHOLD=-5.0       # % rate-of-change for sell

# Optional: comma-separated list of seed wallet addresses to analyse
# SEED_WALLETS=addr1,addr2,addr3
